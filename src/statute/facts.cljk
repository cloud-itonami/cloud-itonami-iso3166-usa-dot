     :statute/cfr-node      [["subtitle" "B"] ["chapter" "VI"] ["part" "665"]]
     :statute/url           "https://www.ecfr.gov/current/title-49/subtitle-B/chapter-VI/part-665"
     :statute/verified-label "Bus Testing"
